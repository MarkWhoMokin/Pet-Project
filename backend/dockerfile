# 1. Базовый образ. Изучаем "легкие" версии (alpine или slim)
FROM python:3.12-slim

# 2. Указываем рабочую директорию внутри контейнера
WORKDIR /app

# 3. Копируем файл зависимостей
COPY requirements.txt .

# 4. Устанавливаем библиотеки (без кэша, чтобы образ был меньше)
RUN pip install --no-cache-dir -r requirements.txt

# 5. Копируем весь остальной код бэкенда в контейнер
COPY . .

# 6. Команда для запуска приложения
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
